#!/usr/bin/env bash
# awsbox — local AWS stack lifecycle (SeaweedFS S3 + LocalStack IAM + console).
# Usage: awsbox up | down | status | console | hosts | mirror | apply …
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

COMPOSE=(docker compose -f "$ROOT/docker-compose.yml")
ENDPOINT_DEFAULT="http://127.0.0.1:8333"
IAM_ENDPOINT_DEFAULT="http://127.0.0.1:4566"
CONSOLE_PID_FILE="$ROOT/.awsbox/console.pid"

ensure_env() {
	if [[ ! -f "$ROOT/.env" ]]; then
		cp "$ROOT/.env.example" "$ROOT/.env"
		echo "created .env from .env.example"
	fi
}

sync_console_env() {
	ensure_env
	# shellcheck disable=SC1091
	set -a && source "$ROOT/.env" && set +a
	mkdir -p "$ROOT/console"
	cat > "$ROOT/console/.env" <<EOF
VITE_AWS_ACCESS_KEY_ID=${AWSBOX_ACCESS_KEY:-awsbox}
VITE_AWS_SECRET_ACCESS_KEY=${AWSBOX_SECRET_KEY:-awsboxawsbox}
VITE_AWS_REGION=${AWSBOX_REGION:-us-east-1}
VITE_AWS_ACCOUNT_ID=${AWSBOX_ACCOUNT_ID:-000000000000}
VITE_AWS_REGION_LABEL=${AWSBOX_REGION_LABEL:-US East (N. Virginia)}
VITE_S3_ENDPOINT=${AWSBOX_ENDPOINT:-$ENDPOINT_DEFAULT}
VITE_IAM_ENDPOINT=/aws-iam
VITE_IAM_PROXY_TARGET=${AWSBOX_IAM_ENDPOINT:-$IAM_ENDPOINT_DEFAULT}
EOF
}

endpoint_url() {
	if [[ -f "$ROOT/.env" ]]; then
		# shellcheck disable=SC1091
		set -a && source "$ROOT/.env" && set +a
	fi
	echo "${AWSBOX_ENDPOINT:-$ENDPOINT_DEFAULT}"
}

iam_endpoint_url() {
	if [[ -f "$ROOT/.env" ]]; then
		# shellcheck disable=SC1091
		set -a && source "$ROOT/.env" && set +a
	fi
	echo "${AWSBOX_IAM_ENDPOINT:-$IAM_ENDPOINT_DEFAULT}"
}

wait_healthy() {
	local ep i code
	ep="$(endpoint_url)"
	for i in $(seq 1 40); do
		code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "${ep}/" || true)"
		if [[ "$code" =~ ^[12345][0-9][0-9]$ ]]; then
			break
		fi
		sleep 1
		if [[ "$i" -eq 40 ]]; then
			echo "error: S3 endpoint did not become ready: ${ep}" >&2
			"${COMPOSE[@]}" ps >&2 || true
			"${COMPOSE[@]}" logs --tail 40 s3 >&2 || true
			exit 1
		fi
	done

	ep="$(iam_endpoint_url)"
	for i in $(seq 1 90); do
		if curl -sf --max-time 2 "${ep}/_localstack/health" >/dev/null 2>&1 \
			|| curl -sf --max-time 2 "${ep}/_localemu/health" >/dev/null 2>&1; then
			return 0
		fi
		code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "${ep}/" || true)"
		if [[ "$code" =~ ^[12345][0-9][0-9]$ ]]; then
			return 0
		fi
		sleep 1
	done
	echo "error: IAM endpoint did not become ready: ${ep}" >&2
	"${COMPOSE[@]}" ps >&2 || true
	"${COMPOSE[@]}" logs --tail 60 localstack >&2 || true
	exit 1
}

cmd_up() {
	if ! command -v docker >/dev/null 2>&1; then
		echo "error: Docker is required (not found on PATH)" >&2
		exit 1
	fi
	ensure_env
	"${COMPOSE[@]}" up -d
	wait_healthy
	"$ROOT/bin/awsbox-profile" write "$@"
	sync_console_env
	local ep iam
	ep="$(endpoint_url)"
	iam="$(iam_endpoint_url)"
	echo
	echo "S3 API:   ${ep}"
	echo "IAM/Lambda: ${iam}"
	echo "Profile:  local  (aws --profile local s3 ls | lambda list-functions)"
	echo "Console:  ./bin/awsbox console   → http://127.0.0.1:3000"
	# Prowler / S3 Control need awsbox.localhost (RFC 6761 often missing on WSL).
	if ! "$ROOT/bin/awsbox-hosts" check >/dev/null 2>&1; then
		echo
		echo "Prowler host: awsbox.localhost not resolving (needed for S3 Control)."
		echo "  ./bin/awsbox-hosts print   # line to add"
		echo "  ./bin/awsbox-hosts apply   # sudo append to /etc/hosts"
		echo "  docs/prowler.md            # WSL / Windows hosts notes"
	fi
}

cmd_down() {
	local remove_profile=0
	if [[ "${1:-}" == "--remove-profile" ]]; then
		remove_profile=1
		shift
	fi
	if [[ -f "$CONSOLE_PID_FILE" ]]; then
		kill "$(cat "$CONSOLE_PID_FILE")" 2>/dev/null || true
		rm -f "$CONSOLE_PID_FILE"
	fi
	"${COMPOSE[@]}" down "$@"
	if [[ "$remove_profile" -eq 1 ]]; then
		"$ROOT/bin/awsbox-profile" remove
	fi
}

cmd_status() {
	ensure_env
	"${COMPOSE[@]}" ps
	local ep code iam
	ep="$(endpoint_url)"
	code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "${ep}/" || true)"
	if [[ "$code" =~ ^[12345][0-9][0-9]$ ]]; then
		echo "s3:       ${ep} (live, http ${code})"
	else
		echo "s3:       ${ep} (not reachable)"
	fi
	iam="$(iam_endpoint_url)"
	if curl -sf --max-time 1 "${iam}/_localstack/health" >/dev/null 2>&1 \
		|| curl -sf --max-time 1 "${iam}/_localemu/health" >/dev/null 2>&1 \
		|| [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "${iam}/" || true)" =~ ^[12345][0-9][0-9]$ ]]; then
		echo "iam:      ${iam} (live)"
	else
		echo "iam:      ${iam} (not reachable)"
	fi
	if [[ -f "$CONSOLE_PID_FILE" ]] && kill -0 "$(cat "$CONSOLE_PID_FILE")" 2>/dev/null; then
		echo "console:  http://127.0.0.1:3000 (pid $(cat "$CONSOLE_PID_FILE"))"
	else
		echo "console:  not running (./bin/awsbox console)"
	fi
	if [[ -n "${AWSBOX_LABELS:-}" ]]; then
		echo "labels:   ${AWSBOX_LABELS}"
	else
		echo "labels:   unset (docs/labels.md)"
	fi
}

cmd_console() {
	sync_console_env
	if [[ ! -d "$ROOT/console/node_modules" ]]; then
		echo "installing console deps (yarn)…"
		(cd "$ROOT/console" && yarn install)
	fi
	mkdir -p "$ROOT/.awsbox"
	cd "$ROOT/console"
	# foreground so logs visible; Ctrl+C stops
	exec yarn dev --host 127.0.0.1 --port 3000
}

case "${1:-}" in
	up)
		shift
		cmd_up "$@"
		;;
	down)
		shift
		cmd_down "$@"
		;;
	status)
		cmd_status
		;;
	console)
		cmd_console
		;;
	hosts)
		shift
		exec "$ROOT/bin/awsbox-hosts" "$@"
		;;
	mirror|apply)
		exec "$ROOT/bin/awsl-mirror.sh" "$@"
		;;
	*)
		echo "Usage: $0 up [--force] | down [--remove-profile] | status | console | hosts … | mirror … | apply <fixture>" >&2
		exit 1
		;;
esac
