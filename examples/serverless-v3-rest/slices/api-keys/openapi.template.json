{
  "openapi": "3.0.1",
  "info": { "title": "awsbox-api-keys", "version": "1" },
  "components": {
    "securitySchemes": {
      "api_key": { "type": "apiKey", "name": "x-api-key", "in": "header" }
    }
  },
  "paths": {
    "/v1/items": {
      "get": {
        "security": [{ "api_key": [] }],
        "x-amazon-apigateway-integration": { "type": "aws_proxy", "httpMethod": "POST", "uri": "${HANDLER_URI}" }
      }
    },
    "/public/ping": {
      "get": {
        "x-amazon-apigateway-integration": { "type": "aws_proxy", "httpMethod": "POST", "uri": "${HANDLER_URI}" }
      }
    }
  }
}
