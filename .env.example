# Copy to .env — used by docker compose and bin/awsbox-profile
AWSBOX_ACCESS_KEY=awsbox
AWSBOX_SECRET_KEY=awsboxawsbox
AWSBOX_REGION=us-east-1
AWSBOX_ENDPOINT=http://127.0.0.1:8333
AWSBOX_IAM_ENDPOINT=http://127.0.0.1:4566
# Lambda container docker flags (docs/lambda-vpc.md). Add --add-host=<name>:host-gateway per host service.
AWSBOX_LAMBDA_DOCKER_FLAGS=--add-host=host.docker.internal:host-gateway
# Account ids. AWSBOX_ACCOUNT_ID replaces 000000000000 in ARNs; AWSBOX_ACCOUNT_IDS maps
# access keys to accounts and wins. Restart ./bin/awsbox up after changing.
# See docs/multi-account.md and docs/custom-ids.md.
# AWSBOX_ACCOUNT_ID=123456789012
# AWSBOX_ACCOUNT_IDS=awsbox-a=111111111111,awsbox-b=222222222222,awsbox-c=333333333333
# Optional console display names. Keep the file outside this repo (docs/labels.md).
# AWSBOX_LABELS=$HOME/awsbox-labels.yaml
# Inbound Transfer SFTP on the host (docs/transfer.md). Default 2222.
# AWSBOX_SFTP_HOST_PORT=2222
# Password SFTP for the legacy-sftp compose profile. Default 2223.
# AWSBOX_LEGACY_SFTP_HOST_PORT=2223
