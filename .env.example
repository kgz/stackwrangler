# Copy to .env — used by docker compose and bin/awsbox-profile
AWSBOX_ACCESS_KEY=awsbox
AWSBOX_SECRET_KEY=awsboxawsbox
AWSBOX_REGION=us-east-1
AWSBOX_ENDPOINT=http://127.0.0.1:8333
AWSBOX_IAM_ENDPOINT=http://127.0.0.1:4566
# Lambda container docker flags (docs/lambda-vpc.md). Add --add-host=<name>:host-gateway per host service.
AWSBOX_LAMBDA_DOCKER_FLAGS=--add-host=host.docker.internal:host-gateway
# Multi-account. Restart ./bin/awsbox up after changing. See docs/multi-account.md.
# AWSBOX_ACCOUNT_ID=123456789012
# AWSBOX_ACCOUNT_IDS=awsbox-a=111111111111,awsbox-b=222222222222,awsbox-c=333333333333
