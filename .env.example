# Copy to .env — used by docker compose and bin/awsbox-profile
# Canonical prefix is STACKWRANGLER_*. AWSBOX_* still works if these are unset.
STACKWRANGLER_ACCESS_KEY=stackwrangler
STACKWRANGLER_SECRET_KEY=stackwranglerstackwrangler
STACKWRANGLER_REGION=us-east-1
STACKWRANGLER_ENDPOINT=http://127.0.0.1:8333
STACKWRANGLER_IAM_ENDPOINT=http://127.0.0.1:4566
# Optional: shorten STS AssumeRole sessions for ESM cred-refresh smoke (#475).
# Requires recreate of LocalEmu. Example: 90
# STACKWRANGLER_STS_ASSUME_ROLE_DURATION=
# Lambda container docker flags (docs/lambda-vpc.md). Add --add-host=<name>:host-gateway per host service.
# SQS QueueUrl hosts (sqs.<region>.localhost) are injected automatically (#459) — no flag needed.
STACKWRANGLER_LAMBDA_DOCKER_FLAGS=--add-host=host.docker.internal:host-gateway
# Account ids. STACKWRANGLER_ACCOUNT_ID replaces 000000000000 in ARNs; STACKWRANGLER_ACCOUNT_IDS maps
# access keys to accounts and wins. Restart ./bin/stackwrangler up after changing.
# See docs/multi-account.md and docs/custom-ids.md.
# STACKWRANGLER_ACCOUNT_ID=123456789012
# STACKWRANGLER_ACCOUNT_IDS=stackwrangler-a=111111111111,stackwrangler-b=222222222222,stackwrangler-c=333333333333
# Optional console display names. Keep the file outside this repo (docs/labels.md).
# STACKWRANGLER_LABELS=$HOME/stackwrangler-labels.yaml
# Inbound Transfer SFTP on the host (docs/transfer.md). Default 2222.
# STACKWRANGLER_SFTP_HOST_PORT=2222
# Password SFTP for the legacy-sftp compose profile. Default 2223.
# STACKWRANGLER_LEGACY_SFTP_HOST_PORT=2223
# Serverless Framework v4 (docs/serverless-awsbox.md). One required for
# ./smokes/iac/serverless-v4-smoke.sh / ./bin/stackwrangler sls — CLI validates remotely (not offline).
# SERVERLESS_ACCESS_KEY=
# SERVERLESS_LICENSE_KEY=
# Maintainer alias: used as SERVERLESS_LICENSE_KEY when that var is unset (never commit the value).
# SERVERLESS_LOCAL_ONLY_LICENCE_KEY=
