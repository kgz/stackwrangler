# Patched LocalEmu for the public image install path (#487).
# Bake localemu-patches so compose.release.yml needs no git checkout bind mounts.
ARG LOCALEMU_DIGEST=sha256:86a84bf21e3c0cf2cb695bdd890bce642e8e3d852c41f46d7aa8123551cee10b
FROM localemu/localemu@${LOCALEMU_DIGEST}

USER root

COPY localemu-patches/s3control_provider.py /opt/code/localemu/src/localemu/services/s3control/provider.py
COPY localemu-patches/rds_engine_mapping.py /opt/code/localemu/src/localemu/services/rds/docker/engine_mapping.py
COPY localemu-patches/s3_storage_ephemeral.py /opt/code/localemu/src/localemu/services/s3/storage/ephemeral.py
COPY localemu-patches/state_persistence.py /opt/code/localemu/src/localemu/state/persistence.py
COPY localemu-patches/init/boot.d /etc/localemu/init/boot.d
COPY localemu-patches/init/start.d /etc/localemu/init/start.d
COPY localemu-patches/wheels /opt/awsbox/wheels
COPY localemu-patches/paramiko_vendor.py /opt/awsbox/paramiko_vendor.py
COPY localemu-patches/oidc /opt/awsbox/oidc
COPY localemu-patches/ecs_task_manager.py /opt/code/localemu/src/localemu/services/ecs/docker/task_manager.py
COPY localemu-patches/ecs_provider.py /opt/code/localemu/src/localemu/services/ecs/provider.py
COPY localemu-patches/ecs_ec2_services.py /opt/code/localemu/src/localemu/services/ecs/ec2_services.py
COPY localemu-patches/iam_arn_builder.py /opt/code/localemu/src/localemu/services/iam_enforcement/arn_builder.py
COPY localemu-patches/resource_tag_loader.py /opt/code/localemu/src/localemu/services/iam_enforcement/resource_tag_loader.py
COPY localemu-patches/service_action_map.py /opt/code/localemu/src/localemu/services/iam_enforcement/service_action_map.py
COPY localemu-patches/iam_enforcer.py /opt/code/localemu/src/localemu/services/iam_enforcement/enforcer.py
COPY localemu-patches/resource_policies.py /opt/code/localemu/src/localemu/services/iam_enforcement/resource_policies.py
COPY localemu-patches/cfn_v2_provider.py /opt/code/localemu/src/localemu/services/cloudformation/v2/provider.py
COPY localemu-patches/cfn_change_set_model_executor.py /opt/code/localemu/src/localemu/services/cloudformation/engine/v2/change_set_model_executor.py
COPY localemu-patches/cfn_deploy_credentials.py /opt/code/localemu/src/localemu/services/cloudformation/cfn_deploy_credentials.py
COPY localemu-patches/vpc_routing.py /opt/code/localemu/src/localemu/services/ec2/docker/vpc_routing.py
COPY localemu-patches/sg_enforcement.py /opt/code/localemu/src/localemu/services/ec2/docker/sg_enforcement.py
COPY localemu-patches/vpce_private_dns.py /opt/code/localemu/src/localemu/services/ec2/docker/vpce_private_dns.py
COPY localemu-patches/vpc_endpoint.py /opt/code/localemu/src/localemu/services/ec2/docker/vpc_endpoint.py
COPY localemu-patches/elbv2_listener_router.py /opt/code/localemu/src/localemu/services/elbv2/listener_router.py
COPY localemu-patches/elbv2_provider.py /opt/code/localemu/src/localemu/services/elbv2/provider.py
COPY localemu-patches/dns_common.py /opt/awsbox/dns/awsbox_dns_common.py
COPY localemu-patches/esm_common.py /opt/awsbox/esm/awsbox_esm_common.py
COPY localemu-patches/ecr_pull.py /opt/awsbox/ecr/awsbox_ecr_pull.py
COPY localemu-patches/gateway_tls.py /opt/awsbox/tls/awsbox_gateway_tls.py
COPY localemu-patches/r53_private_resolver.py /opt/code/localemu/src/localemu/services/route53/private_resolver.py
