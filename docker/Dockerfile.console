# Static console for the public image path — no Vite-from-clone.
FROM node:22-bookworm AS build
WORKDIR /repo
COPY console/package.json console/yarn.lock /repo/console/
WORKDIR /repo/console
RUN yarn install --frozen-lockfile
COPY console/ /repo/console/
# tokens.css is imported as ../../design/stackwrangler/tokens.css from src/
COPY design/stackwrangler/ /repo/design/stackwrangler/
COPY design/stackwrangler-console/assets/ /repo/design/stackwrangler-console/assets/
# Defaults match .env.example / public install docs (product demo keys, not cloud secrets).
ARG VITE_AWS_ACCESS_KEY_ID=stackwrangler
ARG VITE_AWS_SECRET_ACCESS_KEY=stackwranglerstackwrangler
ARG VITE_AWS_REGION=us-east-1
ARG VITE_AWS_ACCOUNT_ID=000000000000
ARG VITE_AWS_REGION_LABEL="US East (N. Virginia)"
ARG VITE_S3_ENDPOINT=http://127.0.0.1:8333
ARG VITE_IAM_ENDPOINT=/aws-iam
ARG VITE_IAM_PROXY_TARGET=http://127.0.0.1:4566
ENV VITE_AWS_ACCESS_KEY_ID=$VITE_AWS_ACCESS_KEY_ID \
    VITE_AWS_SECRET_ACCESS_KEY=$VITE_AWS_SECRET_ACCESS_KEY \
    VITE_AWS_REGION=$VITE_AWS_REGION \
    VITE_AWS_ACCOUNT_ID=$VITE_AWS_ACCOUNT_ID \
    VITE_AWS_REGION_LABEL=$VITE_AWS_REGION_LABEL \
    VITE_S3_ENDPOINT=$VITE_S3_ENDPOINT \
    VITE_IAM_ENDPOINT=$VITE_IAM_ENDPOINT \
    VITE_IAM_PROXY_TARGET=$VITE_IAM_PROXY_TARGET
RUN yarn build

FROM nginx:1.27-alpine
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/console/dist /usr/share/nginx/html
EXPOSE 80
